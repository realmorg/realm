{
  "name": "realm-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "spec": "openspec validate --specs --strict && node scripts/check-scenarios.mjs",
    "change": "changeset",
    "release": "turbo run build test && changeset publish",
    "size": "node scripts/check-size.mjs",
    "release:check": "node scripts/release-check.mjs",
    "skill": "node scripts/build-skill.mjs",
    "version-packages": "changeset version && node scripts/build-skill.mjs",
    "skill:check": "node scripts/build-skill.mjs --check",
    "skill:test": "node --test scripts/skill.test.mjs",
    "scripts:test": "node --test scripts/purge-cdn.test.mjs scripts/indexnow.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@fission-ai/openspec": "1.14.3",
    "playwright": "1.64.1",
    "turbo": "2.11.9"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  }
}
