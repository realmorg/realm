{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/*.md",
      "!pro",
      "!apps/site/public/google*.html",
      "!apps/site/public/yandex_*.html",
      "!apps/site/public/BingSiteAuth.xml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useValidAnchor": "off",
            "useAnchorContent": "off",
            "useHeadingContent": "off",
            "noInteractiveElementToNoninteractiveRole": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "noNoninteractiveTabindex": "off",
            "useAriaPropsForRole": "off",
            "useAriaPropsSupportedByRole": "off",
            "useFocusableInteractive": "off",
            "useAltText": "off",
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
