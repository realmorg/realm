{
  "name": "@realmorg/realm",
  "version": "2.0.0-alpha.0",
  "description": "Build native web components with HTML: one <custom-element> tag, plain JavaScript, no compiler.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ribhararnus Pracutian",
    "email": "oknoorap@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realmui/realm.git",
    "directory": "packages/realm"
  },
  "homepage": "https://realmui.github.io",
  "keywords": [
    "web-components",
    "custom-elements",
    "html",
    "reactive",
    "no-build"
  ],
  "sideEffects": [
    "./dist/realm.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/realm.js"
    },
    "./compiler": {
      "types": "./dist/types/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./realm.css": "./dist/realm.css"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "test": "vitest run",
    "test:cross": "vitest run --project cross",
    "coverage": "vitest run --project chromium --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "playwright": "1.64.1",
    "tsconfig": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
